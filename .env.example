# Admin dashboard passcode. REQUIRED: if this is not set, admin login is disabled.
# Use a long, unique value.
ADMIN_PASSWORD=

# Optional: separate secret used to sign admin sessions (falls back to ADMIN_PASSWORD).
# ADMIN_SECRET=

# -------------------------------------------------------------------
# OPTION 1: Resend (https://resend.com)
# -------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Jude Osamor <onboarding@resend.dev>"

# -------------------------------------------------------------------
# OPTION 2: Nodemailer / Standard SMTP (Gmail, Brevo, AWS SES, etc.)
# -------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Jude Osamor <you@example.com>"
